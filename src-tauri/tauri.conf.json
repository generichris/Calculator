{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Calculator",
  "version": "0.1.0",
  "identifier": "com.chris.calculator",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Calculator",
        "width": 250,
        "height": 275,
        "resizable": false,
        "decorations": false,
        "transparent": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
